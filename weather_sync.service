[Unit]
Description=Weather Data MQ Auto Sync Service
After=network.target mysql.service rabbitmq-server.service

[Service]
Type=simple
User=sc
Group=sc
WorkingDirectory=/home/sc/weather_forecast
# 建議使用絕對路徑指向您的 python
ExecStart=/usr/bin/python3 /home/sc/weather_forecast/main_service.py
# 程式崩庫時，5 秒後自動嘗試重啟
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
